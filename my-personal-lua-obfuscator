local function generateKey()
	local key = {}
	math.randomseed(tick())
	for i = 1, 16 do
		key[i] = math.random(1, 255)
	end
	return key
end

local function xorEncrypt(text, key)
	local result = {}
	local keyLen = #key
	for i = 1, #text do
		local byte = string.byte(text:sub(i, i))
		local keyByte = key[((i - 1) % keyLen) + 1]
		table.insert(result, bit32.bxor(byte, keyByte))
	end
	return result
end

local function obfuscateScript(scriptText)
	local key = generateKey()
	local encrypted = xorEncrypt(scriptText, key)
	
	local varNames = {
		"_" .. string.char(math.random(65, 90)) .. math.random(1000, 9999),
		"_" .. string.char(math.random(65, 90)) .. math.random(1000, 9999),
		"_" .. string.char(math.random(65, 90)) .. math.random(1000, 9999)
	}
	
	local keyStr = table.concat(key, ",")
	local dataStr = table.concat(encrypted, ",")
	
	return string.format([[local %s={%s}local %s={%s}local function %s(d,k)local r={}for i=1,#d do r[i]=string.char(bit32.bxor(d[i],k[((i-1)%%#k)+1]))end return table.concat(r)end loadstring(%s(%s,%s))()]], 
		varNames[1], keyStr,
		varNames[2], dataStr,
		varNames[3],
		varNames[3], varNames[2], varNames[1]
	)
end

