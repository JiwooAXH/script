local function generateVarName()
	local chars = "abcdefghijklmnopqrstuvwxyz"
	local name = ""
	for i = 1, math.random(6, 10) do
		name = name .. chars:sub(math.random(1, #chars), math.random(1, #chars))
	end
	return "_" .. name .. math.random(100, 999)
end

local function obfuscateScript(scriptText)
	math.randomseed(tick())
	
	local key = {}
	for i = 1, 24 do
		key[i] = math.random(1, 255)
	end
	
	local encrypted = {}
	for i = 1, #scriptText do
		local byte = string.byte(scriptText:sub(i, i))
		local keyByte = key[((i - 1) % #key) + 1]
		local xorResult = bit32.bxor(byte, keyByte)
		local rotated = bit32.lrotate(xorResult, i % 7)
		encrypted[i] = rotated
	end
	
	local indices = {}
	for i = 1, #encrypted do
		indices[i] = i
	end
	for i = #indices, 2, -1 do
		local j = math.random(i)
		indices[i], indices[j] = indices[j], indices[i]
	end
	
	local shuffled = {}
	for i = 1, #indices do
		shuffled[i] = encrypted[indices[i]]
	end
	
	local v1 = generateVarName()
	local v2 = generateVarName()
	local v3 = generateVarName()
	local v4 = generateVarName()
	local v5 = generateVarName()
	local v6 = generateVarName()
	
	local keyStr = table.concat(key, ",")
	local dataStr = table.concat(shuffled, ",")
	local orderStr = table.concat(indices, ",")
	
	local loader = "local " .. v1 .. "={" .. keyStr .. "};"
	loader = loader .. "local " .. v2 .. "={" .. dataStr .. "};"
	loader = loader .. "local " .. v3 .. "={" .. orderStr .. "};"
	loader = loader .. "local function " .. v4 .. "(d,o)"
	loader = loader .. " local u={}"
	loader = loader .. " for i=1,#o do"
	loader = loader .. "  u[o[i]]=d[i]"
	loader = loader .. " end"
	loader = loader .. " return u"
	loader = loader .. " end;"
	loader = loader .. "local function " .. v5 .. "(e,k)"
	loader = loader .. " local r={}"
	loader = loader .. " for i=1,#e do"
	loader = loader .. "  local rt=bit32.rrotate(e[i],i%7)"
	loader = loader .. "  r[i]=string.char(bit32.bxor(rt,k[((i-1)%#k)+1]))"
	loader = loader .. " end"
	loader = loader .. " return table.concat(r)"
	loader = loader .. " end;"
	loader = loader .. "local " .. v6 .. "=" .. v4 .. "(" .. v2 .. "," .. v3 .. ");"
	loader = loader .. "loadstring(" .. v5 .. "(" .. v6 .. "," .. v1 .. "))()"
	
	return loader
end

